# Deliberately publish source only; existing research data and backups stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/DATA_SOURCES.md
!/CONTRIBUTING.md
!/requirements.txt
!/requirements-routing.txt
!/run.py
!/build_gtfs.sh
!/scripts/
/scripts/*
!/scripts/*.py
!/scripts/hkbus_pilot/
!/scripts/hkrail/
!/scripts/hkbus_pilot/*.py
!/scripts/hkbus_pilot/README.md
!/scripts/hkrail/*.py
!/scripts/hkrail/README.md
!/route_checker/
/route_checker/*
!/route_checker/*.py
!/route_checker/index.html
!/route_checker/multi.html
!/route_checker/multi_examples.json
!/route_checker/README.md
!/tests/
!/tests/*.py
!/docs/
!/docs/**
!/.github/
!/.github/**
**/__pycache__/
**/*.pyc
**/.DS_Store
**/.env
**/.env.*
**/*.pem
**/*.key

# Canonical authenticated-app adapter included in reproducible routing releases.
!/scripts/templates/
!/scripts/templates/w8g_routing.py
